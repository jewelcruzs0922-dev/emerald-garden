{
  "name": "leaf-and-root",
  "version": "1.0.0",
  "private": true,
  "description": "Leaf & Root — a boutique bonsai shop storefront, built with Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
