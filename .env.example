# ---------------------------------------------------------------------------
# Leaf & Root — environment
# Copy to `.env.local` and fill in. Without these the contact and newsletter
# forms still validate, but submissions are logged to the server console
# instead of being emailed, and the UI reports that honestly.
# ---------------------------------------------------------------------------

# Public origin, used for canonical URLs, sitemap and OpenGraph tags.
# Only read on the server, so either name works; SITE_URL is preferred and
# NEXT_PUBLIC_SITE_URL is still honoured for existing deployments.
SITE_URL=https://leafandroot.ph

# Resend (https://resend.com) — any transactional mail API works; see
# src/lib/mailer.ts if you would rather swap the provider.
RESEND_API_KEY=
LEAF_AND_ROOT_INBOX=hello@leafandroot.ph
LEAF_AND_ROOT_FROM="Leaf & Root <hello@leafandroot.ph>"

# ---------------------------------------------------------------------------
# Payments
# Leave STRIPE_SECRET_KEY blank and checkout runs through the built-in mock
# provider: the full flow works, but no money moves. Set it and checkout
# switches to Stripe Checkout automatically.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Storage
# Leave blank locally: orders and inventory are written to ./data as JSON.
# Set to "memory" on a read-only filesystem (Vercel, a read-only container).
# Memory mode is also detected automatically when a write fails, so the
# checkout degrades instead of returning a 500 � state simply does not survive
# a restart.
# ---------------------------------------------------------------------------
LEAF_AND_ROOT_STORAGE=
